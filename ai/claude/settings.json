{
  "model": "sonnet",
  "cleanupPeriodDays": 365,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "agent-guard.mjs"
            ],
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "theme": "dark",
  "syncClaudeAiSkills": false,
  "skillOverrides": {
    "claude-api": "name-only",
    "dataviz": "name-only",
    "keybindings-help": "user-invocable-only",
    "matt-prototype": "name-only",
    "matt-research": "name-only",
    "matt-tdd": "name-only",
    "matt-wizard": "name-only",
    "plugin-authoring": "user-invocable-only",
    "workflow-authoring": "name-only"
  },
  "enabledPlugins": {
    "bloomfilter-agent-miner-claude-code-windows@bloomfilter-plugins": false,
    "mattpocock-skills@mattpocock": false
  },
  "extraKnownMarketplaces": {
    "bloomfilter-plugins": {
      "source": {
        "source": "github",
        "repo": "Bloomfilter-Engineering/bloomfilter-plugins"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh repo view:*)",
      "Bash(git branch:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(rg:*)",
      "Bash(tail:*)"
    ]
  }
}
