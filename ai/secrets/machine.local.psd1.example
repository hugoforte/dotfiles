# Per-machine settings for deploy-secrets.ps1 and setup.ps1. Copy to machine.local.psd1 (git-ignored) and edit.
@{
    # Directories whose immediate children are git checkouts to search for managed skills.
    SearchRoots = @('C:\source')

    # Absolute paths of overlay directories, each laid out like this repo's root: any of
    # ai/secrets/registry.psd1 (+ ai/secrets/<Id>/), aws/config, git/gitconfig, .sops.yaml.
    # See ai/secrets/README.md. Leave empty when this machine has none.
    Overlays = @()
}
