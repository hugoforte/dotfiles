#!/bin/sh

# Git Bash entry point for ai/helpers/leak-check.sh; leak-check.cmd is the one for PowerShell and
# cmd. On PATH so an agent can check dotfiles before it pushes, from wherever it stands:
#   leak-check            the tracked files
#   leak-check --pr 12    and pull request 12's title, body and commit messages
exec sh "$(dirname "$0")/../ai/helpers/leak-check.sh" "$@"
