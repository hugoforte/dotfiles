[user]
	name = Hugo Forte
	email = hugo@hugoforte.com
[core]
	autocrlf = true
	longpaths = true
[difftool "sourcetree"]
	cmd = "'' "
[mergetool "sourcetree"]
	cmd = "'' "
	trustExitCode = true
[credential "https://github.com"]
	helper =
	helper = !'C:\\Program Files\\GitHub CLI\\gh.exe' auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !'C:\\Program Files\\GitHub CLI\\gh.exe' auth git-credential
[windows]
	appendAtomically = false
[includeIf "hasconfig:remote.*.url:https://github.com/employer/**"]
	path = ~/.gitconfig-employer
