# No name or email: the identity comes from an overlay's git/gitconfig, through ~/.gitconfig-overlays
# below. Until one does, git refuses to commit rather than make one up from the host name.
[user]
	useConfigOnly = true
[core]
	autocrlf = true
	longpaths = true
[difftool "sourcetree"]
	cmd = "'' "
[mergetool "sourcetree"]
	cmd = "'' "
	trustExitCode = true
[credential "https://github.com"]
	helper =
	helper = !'C:\\Program Files\\GitHub CLI\\gh.exe' auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !'C:\\Program Files\\GitHub CLI\\gh.exe' auth git-credential
[windows]
	appendAtomically = false
[include]
	path = ~/.gitconfig-overlays
